# ------------------------------------------------------------
# Study data
#
# Participant-level and derived datasets are intentionally
# excluded from version control.
# ------------------------------------------------------------

# Ignore everything in data/ by default
/data/

# Allow documentation inside data/
!data/README.md

# Allow the Collection directory itself
!data/Collection/

# Ignore everything inside Collection by default
data/Collection/*

# Keep non-participant metadata required to understand
# the original survey structure and preprocessing
!data/Collection/codebook_mindspaceOne_2025-01-07.xlsx
!data/Collection/value-codes_mindspaceOne_2025-01-07.csv
!data/Collection/variables_mindspaceOne_2025-01-07.csv


